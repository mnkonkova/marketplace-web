# Caddy: статика фронта + TLS. DOMAIN берётся из env compose'а.
# При первом запуске Caddy сам выпишет Let's Encrypt-сертификат через
# HTTP-01 challenge — DNS должен резолвиться на IP сервера, порт 80
# должен быть открыт. Для тестового деплоя по IP без TLS — DOMAIN=:80.
#
# Вариант 1 (рекомендуется): фронт и API на одном домене, /api/* проксируется
# на бэкенд, остальное — статика. Тогда в index.html __API_BASE__ = "" и CORS
# на API не нужен.
#
# Вариант 2: фронт и API на разных доменах — убрать reverse_proxy /api/*,
# в index.html прописать __API_BASE__ = "https://api.example.com", и на API
# выставить CORS_ORIGINS со своим доменом.

{$DOMAIN} {
	encode zstd gzip
	root * /srv

	# /api/* → бэкенд. Замени upstream на адрес своего API (или убери блок,
	# если API живёт на отдельном домене).
	#
	# lb_try_duration + lb_try_interval — zero-downtime ретраи. Если api
	# рестартует (deploy), Caddy ждёт пока upstream поднимется и повторяет
	# запрос — пользователь видит «медленный» запрос, а не 502.
	# fail_duration — сколько помнить, что upstream был сломан.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080} {
			lb_try_duration 15s
			lb_try_interval 250ms
			fail_duration   1s
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# /swagger/* тоже на бэкенд (если хочешь оставить swagger UI публичным).
	handle /swagger/* {
		reverse_proxy {$API_UPSTREAM:api:8080} {
			lb_try_duration 15s
			lb_try_interval 250ms
			fail_duration   1s
		}
	}

	# Статика + SPA fallback: любой GET вне /api отдаёт index.html, чтобы
	# /search и /specialist/:id работали при прямом заходе.
	#
	# Cache-Control:
	#   • hashed-assets (chunk-*.js, chunk-*.css, *.woff2, изображения) —
	#     immutable на год: имя файла содержит content-hash от Angular CLI,
	#     старая версия под тем же именем никогда не всплывёт.
	#   • index.html и manifest — no-cache: HTML-shell перезагружается
	#     каждый заход, чтобы юзер увидел новый билд без Ctrl+F5.
	#   • sitemap.xml / robots.txt — короткий кеш, чтобы Яндекс/Google
	#     подхватывали обновления быстро, но не долбили каждый скролл.
	# Страница специалиста идёт через API — он отдаёт ту же оболочку SPA, но
	# с og-метой конкретного человека. Нужно ради превью ссылок: боты
	# Telegram/WhatsApp/VK не исполняют JS и читают только теги из первого
	# HTML-ответа, а в статическом index.html лежит общая мета сайта.
	#
	# handle_response на 4xx/5xx возвращает обычный index.html: если API
	# лёг или специалиста нет, страница всё равно откроется (SPA сам покажет
	# «Профиль не найден»), просто без персональной меты.
	handle /specialist/* {
		reverse_proxy {$API_UPSTREAM:api:8080} {
			lb_try_duration 5s
			lb_try_interval 250ms
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}

			@spaFallback status 4xx 5xx
			handle_response @spaFallback {
				rewrite * /index.html
				file_server
			}
		}
	}

	@hashedAsset {
		path_regexp \.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|ico|webp|avif|mp4)$
	}
	header @hashedAsset Cache-Control "public, max-age=31536000, immutable"

	@htmlShell {
		path /index.html / /manifest.webmanifest
	}
	header @htmlShell Cache-Control "no-cache, must-revalidate"

	@seoFiles {
		path /robots.txt /sitemap.xml
	}
	header @seoFiles Cache-Control "public, max-age=3600"

	handle {
		try_files {path} /index.html
		file_server
	}
}

# www.<DOMAIN> → 301 редирект на apex. DNS должен указывать www на тот же IP,
# Caddy выпишет отдельный сертификат и редиректнет.
# http и https — оба сразу на https://apex (без промежуточного шага
# http://www → https://www → https://apex; SEO быстрее реагирует на
# одношаговую цепочку).
http://www.{$DOMAIN}, https://www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# n8n.<DOMAIN> → n8n-контейнер. Поднимается отдельно от compose'а:
#   docker run -d --name marketplace-api-n8n-1 --restart unless-stopped \
#     --network marketplace-api_default -p 5678:5678 \
#     -v marketplace-api_n8n-data:/home/node/.n8n \
#     -e N8N_HOST=n8n.<домен> -e WEBHOOK_URL=https://n8n.<домен>/ \
#     n8nio/n8n
# DNS: A-запись n8n.<DOMAIN> → IP VDS. Если поддомен не нужен — закомментируй
# весь блок (Let's Encrypt всё равно попробует, упрётся в DNS и засрёт логи).
n8n.{$DOMAIN} {
	reverse_proxy marketplace-api-n8n-1:5678 {
		flush_interval -1
	}
}
